*.dmg
*.app/
*.pkg
*.p12
*.p8
*.cer
*.mobileprovision
*.key
*.pem
.tauri/

# ── Local databases (app data / test leftovers) ─────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Environment / secrets ───────────────────────────────────
.env
.env.*
!.env.example

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
